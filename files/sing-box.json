{
  "$schema": "https://sing-box.sagernet.org/schema.json",

  "log": {
    "level": "info",
    "output": "sing-box.log",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "google",
        "server": "8.8.8.8",
        "path": "/dns-query",
        "detour": "Proxy"
      },
      {
        "type": "quic",
        "tag": "local",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],

    "rules": [
      {
        "domain": [
          "cdn.jsdelivr.net"
        ],
        "action": "route",
        "server": "google"
      },

      {
        "clash_mode": "direct",
        "action": "route",
        "server": "local"
      },

      {
        "clash_mode": "global",
        "action": "route",
        "server": "google"
      },

      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "local"
      },

      {
        "action": "route",
        "server": "fakeip"
      }
    ],

    "final": "google",
    "strategy": "prefer_ipv4",
    "timeout": "10s"
  },

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",

      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],

      "stack": "system",
      "auto_route": true,
      "strict_route": true,
      "dns_mode": "hijack",
      "sniff": true,

      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },

    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "sniff": true,
      "users": []
    }
  ],

  "outbounds": [

    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "HongKong",
        "TaiWan",
        "Singapore",
        "Japan",
        "America",
        "Others"
      ],
      "default": "HongKong"
    },

    {
      "tag": "OpenAI",
      "type": "selector",
      "outbounds": [
        "TaiWan",
        "Singapore",
        "Japan",
        "America",
        "Others"
      ],
      "default": "America"
